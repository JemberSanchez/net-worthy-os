 "guion": [
  {
   "id": "hook",
   "texto": "For every dollar America spends on defense, it now pays one dollar and eight cents in interest."
  },
  {
   "id": "y1980",
   "texto": "Nineteen eighty: fifty-eight cents."
  },
  {
   "id": "y2000",
   "texto": "Two thousand: ninety-three cents."
  },
  {
   "id": "y2020",
   "texto": "Twenty twenty: back to sixty-two."
  },
  {
   "id": "rates",
   "texto": "Then the Fed's rate went from near zero to above five percent in twenty months."
  },
  {
   "id": "cross",
   "texto": "Early twenty twenty-four, the lines crossed."
  },
  {
   "id": "stay",
   "texto": "They've stayed crossed for eleven quarters, at one point three trillion dollars a year."
  },
  {
   "id": "fair",
   "texto": "To be fair, this money doesn't vanish: it pays bondholders, maybe your pension fund."
  },
  {
   "id": "taxes",
   "texto": "But your taxes help pay it."
  },
  {
   "id": "end",
   "texto": "And not one dollar pays down the debt."
  }
 ],
