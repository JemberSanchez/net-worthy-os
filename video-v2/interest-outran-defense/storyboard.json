 "guion": [
  {
   "id": "hook",
   "texto": "America now pays more in interest than it spends on defense, and your taxes help cover both."
  },
  {
   "id": "then",
   "texto": "In early twenty twenty, interest cost sixty-two cents per defense dollar."
  },
  {
   "id": "now",
   "texto": "Today it's one dollar and eight cents."
  },
  {
   "id": "shrink",
   "texto": "And defense didn't shrink."
  },
  {
   "id": "outran",
   "texto": "Interest just outran it."
  },
  {
   "id": "collide",
   "texto": "Two things collided: a debt that kept rising, and a Fed rate that jumped off near zero."
  },
  {
   "id": "cross",
   "texto": "Early in twenty twenty-four, the lines crossed."
  },
  {
   "id": "stay",
   "texto": "They've stayed crossed ever since."
  },
  {
   "id": "size",
   "texto": "Now it's one point three trillion dollars a year."
  },
  {
   "id": "fair",
   "texto": "To be fair, this money doesn't vanish: it pays bondholders, maybe your pension fund."
  },
  {
   "id": "end",
   "texto": "But not one dollar of that interest pays down the debt."
  }
 ],
