{
  "ref": "berkshire-1999",
  "guion": [
    {
      "id": "f1",
      "texto": "Berkshire Hathaway, a legendary stock, trailed the market by forty points in 1999."
    },
    {
      "id": "f2",
      "texto": "If you owned it, Warren Buffett looked finished."
    },
    {
      "id": "f3",
      "texto": "Selling right there is the most common mistake in investing.",
      "giro": true
    },
    {
      "id": "f4",
      "texto": "The next year, the tech bubble burst."
    },
    {
      "id": "f5",
      "texto": "Berkshire went up while the market went down.",
      "giro": true
    },
    {
      "id": "f6",
      "texto": "That wasn't even its worst year."
    },
    {
      "id": "f7",
      "texto": "Years earlier, it had crashed even harder.",
      "giro": true
    },
    {
      "id": "f8",
      "texto": "The people who held from the start earned almost twenty percent a year."
    },
    {
      "id": "f9",
      "texto": "The market earned about ten."
    },
    {
      "id": "f10",
      "texto": "But for every Berkshire there were thousands that fell and never came back.",
      "giro": true
    },
    {
      "id": "f11",
      "texto": "Past returns promise nothing."
    },
    {
      "id": "f12",
      "texto": "Remember Berkshire the next time the market scares you."
    }
